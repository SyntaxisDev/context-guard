{
  "tiers": {
    "cheap": {"agent_model": "claude-haiku-5-5[effort=low]", "call": "claude-haiku-5-5-thinking-high"},
    "standard": {"agent_model": "claude-sonnet-5-5[effort=medium]", "call": "claude-sonnet-5-5-medium"},
    "deep": {"agent_model": "claude-opus-5-5[effort=high,context=300k]", "call": "claude-opus-5-5-high"}
  },
  "telemetry": {
    "state_db": "",
    "platform_state_db": {
      "darwin": "~/Library/Application Support/Cursor/User/globalStorage/state.vscdb",
      "linux": "~/.config/Cursor/User/globalStorage/state.vscdb"
    },
    "cli_chats": "~/.cursor/chats",
    "window_fallback": 0,
    "timeout_seconds": 1
  },
  "tools": {
    "read": ["Read"],
    "write": ["Write", "StrReplace", "Edit", "MultiEdit"],
    "shell": ["Shell"],
    "spawn": ["Task"]
  },
  "subagents": {
    "silence_minutes": 10
  }
}
